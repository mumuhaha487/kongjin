{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kongjing-relay",
  "main": "relay/src/worker.mjs",
  "compatibility_date": "2026-10-21",
  "workers_dev": true,
  "assets": {
    "directory": "relay/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "GROUPS", "class_name": "GroupRoom" },
      { "name": "PAIRS", "class_name": "PairRoom" },
      { "name": "GUARDS", "class_name": "Guard" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GroupRoom", "PairRoom", "Guard"] }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "kongjing-sync" }],
  "vars": { "EXTRA_ORIGINS": "https://appassets.androidplatform.net" }
}
