{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [
      "vite/client",
      "chrome",
      "node"
    ],
    "paths": {
      "@kongjing/protocol": [
        "../shared/protocol/src/index.ts"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "tests/**/*.test.ts",
    "vite.config.ts"
  ]
}