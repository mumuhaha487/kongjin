{
  "name": "kongjing-extension",
  "version": "2.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "lint": "eslint src tests",
    "screenshot": "tsx scripts/screenshots.mjs",
    "integration": "tsx tests/integration.ts",
    "smoke": "tsx scripts/smoke.mjs",
    "pack": "node scripts/store.mjs pack:release",
    "pack:release": "npm run build && node scripts/pack.mjs",
    "pack:store": "node scripts/store.mjs pack:release",
    "build:store": "node scripts/store.mjs build",
    "build:store:qa": "node scripts/store.mjs build:qa",
    "store:assets": "node scripts/store.mjs build:qa && tsx scripts/store-assets.mjs",
    "smoke:store": "tsx scripts/store-smoke.mjs",
    "lint:store": "node scripts/store.mjs lint",
    "test:store": "node scripts/store.mjs test",
    "test:ui:store": "node scripts/store.mjs test:ui",
    "test:a11y:store": "node scripts/store.mjs test:a11y",
    "check:store": "node scripts/store.mjs check",
    "preview:store:qa": "vite preview --outDir dist-store-qa --host 127.0.0.1 --port 4176 --strictPort",
    "check": "node scripts/check.mjs",
    "test:ui": "tsx scripts/ui-check.mjs",
    "test:a11y": "tsx scripts/accessibility-check.mjs",
    "build:qa": "tsc -b && vite build --mode qa",
    "preview:qa": "vite preview --outDir dist-qa --host 127.0.0.1 --port 4174",
    "build:android": "node scripts/android.mjs build && npm run check:compat:android",
    "build:android:qa": "node scripts/android.mjs build:qa",
    "preview:android": "vite preview --outDir dist-android --host 127.0.0.1 --port 4182 --strictPort",
    "preview:android:qa": "vite preview --outDir dist-android-qa --host 127.0.0.1 --port 4183 --strictPort",
    "test:ui:android": "tsx scripts/android-ui.mjs",
    "screenshot:android": "tsx scripts/android-ui.mjs --screenshots",
    "integration:android": "tsx scripts/android-integration.mjs",
    "check:android": "tsx scripts/android-check.mjs",
    "check:compat:android": "node scripts/android-compat.mjs",
    "smoke:legacy:android": "tsx scripts/android-legacy.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "core-js": "^3.51.0",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.24",
    "qrcode-generator": "2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simple-icons": "^11.15.0",
    "wicg-inert": "^3.1.3",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@mdn/browser-compat-data": "^8.1.6",
    "@types/chrome": "^0.1.24",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "browserslist": "^4.29.4",
    "crx3": "^1.1.3",
    "eslint": "^9.39.0",
    "eslint-plugin-compat": "^7.0.2",
    "fake-indexeddb": "^6.2.6",
    "jsqr": "1.4.0",
    "lightningcss": "^1.33.0",
    "playwright": "1.56.1",
    "postcss": "^8.5.31",
    "prettier": "3.6.2",
    "sharp": "^0.35.5",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "undici": "^7.16.0",
    "vite": "^6.4.1",
    "vitest": "^5.0.5"
  }
}
