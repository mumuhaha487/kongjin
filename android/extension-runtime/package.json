{
  "name": "@kongjing/extension-runtime",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:chromium": "npm run build && node --test --test-timeout=30000 tests/chromium/*.test.mjs",
    "fixtures": "python scripts/fetch-fixtures.py"
  },
  "devDependencies": { "esbuild": "0.25.12", "typescript": "5.9.3", "playwright": "1.56.1", "acorn": "8.15.0" }
}
